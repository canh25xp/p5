{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 15,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "ninja-debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "ninja-release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "make-debug",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "make-release",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "mingw-make-debug",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/build/Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "mingw-make-release",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/build/Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "msvc2017",
      "generator": "Visual Studio 15 2017",
      "binaryDir": "${sourceDir}/build",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      }
    },
    {
      "name": "msvc2022",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      }
    }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "ninja-debug" },
    { "name": "p4", "configurePreset": "ninja-debug", "targets": "p4" },
    { "name": "p5", "configurePreset": "ninja-debug", "targets": "p5" },
    { "name": "p4-release", "configurePreset": "ninja-release", "targets": "p4" },
    { "name": "p5-release", "configurePreset": "ninja-release", "targets": "p5" },
    { "name": "p4-debug", "configurePreset": "ninja-debug", "targets": "p4" },
    { "name": "p5-debug", "configurePreset": "ninja-debug", "targets": "p5" },
    { "name": "ninja-debug", "configurePreset": "ninja-debug" },
    { "name": "ninja-release", "configurePreset": "ninja-release" },
    { "name": "make-debug", "configurePreset": "make-debug" },
    { "name": "make-release", "configurePreset": "make-release" },
    { "name": "mingw-make-debug", "configurePreset": "mingw-make-debug" },
    { "name": "mingw-make-release", "configurePreset": "mingw-make-release" },
    { "name": "msvc2017-debug", "configurePreset": "msvc2017", "configuration": "Debug" },
    { "name": "msvc2017-release", "configurePreset": "msvc2017", "configuration": "Release" },
    { "name": "msvc2022-debug", "configurePreset": "msvc2022", "configuration": "Debug" },
    { "name": "msvc2022-release", "configurePreset": "msvc2022", "configuration": "Release" }
  ],
  "workflowPresets": [
    {
      "name": "default",
      "steps": [
        { "type": "configure", "name": "ninja-debug" },
        { "type": "build", "name": "ninja-debug" }
      ]
    },
    {
      "name": "ninja-debug",
      "steps": [
        { "type": "configure", "name": "ninja-debug" },
        { "type": "build", "name": "ninja-debug" }
      ]
    },
    {
      "name": "ninja-release",
      "steps": [
        { "type": "configure", "name": "ninja-release" },
        { "type": "build", "name": "ninja-release" }
      ]
    },
    {
      "name": "make-debug",
      "steps": [
        { "type": "configure", "name": "make-debug" },
        { "type": "build", "name": "make-debug" }
      ]
    },
    {
      "name": "make-release",
      "steps": [
        { "type": "configure", "name": "make-release" },
        { "type": "build", "name": "make-release" }
      ]
    },
    {
      "name": "mingw-make-debug",
      "steps": [
        { "type": "configure", "name": "mingw-make-debug" },
        { "type": "build", "name": "mingw-make-debug" }
      ]
    },
    {
      "name": "mingw-make-release",
      "steps": [
        { "type": "configure", "name": "mingw-make-release" },
        { "type": "build", "name": "mingw-make-release" }
      ]
    },
    {
      "name": "msvc2017",
      "steps": [
        { "type": "configure", "name": "msvc2017" },
        { "type": "build", "name": "msvc2017-debug" },
        { "type": "build", "name": "msvc2017-release" }
      ]
    },
    {
      "name": "msvc2022",
      "steps": [
        { "type": "configure", "name": "msvc2022" },
        { "type": "build", "name": "msvc2022-debug" },
        { "type": "build", "name": "msvc2022-release" }
      ]
    }
  ]
}
