{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 15,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "ninja",
      "hidden": true,
      "inherits": ["base"],
      "generator": "Ninja"
    },
    {
      "name": "make",
      "hidden": true,
      "inherits": ["base"],
      "generator": "Unix Makefiles"
    },
    {
      "name": "mingw",
      "hidden": true,
      "inherits": ["base"],
      "generator": "MinGW Makefiles"
    },
    {
      "name": "msvc-base",
      "hidden": true,
      "inherits": ["base"],
      "architecture": {
        "value": "x64",
        "strategy": "set"
      }
    },
    {
      "name": "default",
      "displayName": "Debug (Ninja)",
      "description": "Default debug build using Ninja",
      "inherits": ["ninja"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug (Ninja)",
      "description": "Debug build using Ninja",
      "inherits": ["ninja"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release (Ninja)",
      "description": "Release build using Ninja",
      "inherits": ["ninja"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "make-debug",
      "displayName": "Debug (Unix Makefiles)",
      "description": "Debug build using Unix Makefiles",
      "inherits": ["make"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "make-release",
      "displayName": "Release (Unix Makefiles)",
      "description": "Release build using Unix Makefiles",
      "inherits": ["make"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "mingw-debug",
      "displayName": "Debug (MinGW Makefiles)",
      "description": "Debug build using MinGW Makefiles",
      "inherits": ["mingw"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "mingw-release",
      "displayName": "Release (MinGW Makefiles)",
      "description": "Release build using MinGW Makefiles",
      "inherits": ["mingw"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "msvc2017",
      "displayName": "Visual Studio 15 2017",
      "description": "Multi-config build using Visual Studio 2017",
      "inherits": ["msvc-base"],
      "generator": "Visual Studio 15 2017"
    },
    {
      "name": "msvc2022",
      "displayName": "Visual Studio 17 2022",
      "description": "Multi-config build using Visual Studio 2022",
      "inherits": ["msvc-base"],
      "generator": "Visual Studio 17 2022"
    }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "debug" },
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "make-debug", "configurePreset": "make-debug" },
    { "name": "make-release", "configurePreset": "make-release" },
    { "name": "mingw-debug", "configurePreset": "mingw-debug" },
    { "name": "mingw-release", "configurePreset": "mingw-release" },
    { "name": "msvc2017-debug", "configurePreset": "msvc2017", "configuration": "Debug" },
    { "name": "msvc2017-release", "configurePreset": "msvc2017", "configuration": "Release" },
    { "name": "msvc2022-debug", "configurePreset": "msvc2022", "configuration": "Debug" },
    { "name": "msvc2022-release", "configurePreset": "msvc2022", "configuration": "Release" }
  ],
  "workflowPresets": [
    {
      "name": "default",
      "steps": [
        { "type": "configure", "name": "debug" },
        { "type": "build", "name": "debug" }
      ]
    },
    {
      "name": "debug",
      "steps": [
        { "type": "configure", "name": "debug" },
        { "type": "build", "name": "debug" }
      ]
    },
    {
      "name": "release",
      "steps": [
        { "type": "configure", "name": "release" },
        { "type": "build", "name": "release" }
      ]
    },
    {
      "name": "make-debug",
      "steps": [
        { "type": "configure", "name": "make-debug" },
        { "type": "build", "name": "make-debug" }
      ]
    },
    {
      "name": "make-release",
      "steps": [
        { "type": "configure", "name": "make-release" },
        { "type": "build", "name": "make-release" }
      ]
    },
    {
      "name": "mingw-debug",
      "steps": [
        { "type": "configure", "name": "mingw-debug" },
        { "type": "build", "name": "mingw-debug" }
      ]
    },
    {
      "name": "mingw-release",
      "steps": [
        { "type": "configure", "name": "mingw-release" },
        { "type": "build", "name": "mingw-release" }
      ]
    },
    {
      "name": "msvc2017",
      "steps": [
        { "type": "configure", "name": "msvc2017" },
        { "type": "build", "name": "msvc2017-debug" },
        { "type": "build", "name": "msvc2017-release" }
      ]
    },
    {
      "name": "msvc2022",
      "steps": [
        { "type": "configure", "name": "msvc2022" },
        { "type": "build", "name": "msvc2022-debug" },
        { "type": "build", "name": "msvc2022-release" }
      ]
    }
  ]
}
